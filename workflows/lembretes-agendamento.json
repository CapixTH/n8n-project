      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Ler Agendamentos",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 400]
    },
    {
      "parameters": {
        "jsCode": "// Mantém apenas os agendamentos de AMANHÃ que ainda estão pendentes\nconst amanha = DateTime.now()\n  .setZone('America/Sao_Paulo')\n  .plus({ days: 1 })\n  .toFormat('yyyy-MM-dd');\n\nconst filtrados = $input.all().filter(item => {\n  const data = String(item.json.data || '').trim();\n  const status = String(item.json.status || '').trim().toLowerCase();\n  return data === amanha && status === 'pendente';\n});\n\n// Ordena por horário\nfiltrados.sort((a, b) => String(a.json.hora).localeCompare(String(b.json.hora)));\n\n// Se não houver nada, retorna vazio e o fluxo para aqui\nreturn filtrados;"
      },
      "id": "a1f0c001-0000-4000-8000-000000000010",
      "name": "Filtrar Agendamentos de Amanhã",
