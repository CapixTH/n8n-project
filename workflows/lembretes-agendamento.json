    {
      "parameters": {
        "jsCode": "// Gera um único resumo com todos os lembretes enviados\nconst agendamentos = $('Filtrar Agendamentos de Amanhã').all();\nconst data = DateTime.now().setZone('America/Sao_Paulo').plus({ days: 1 }).toFormat('dd/MM/yyyy');\n\nconst linhas = agendamentos.map(a => `• ${a.json.hora} - ${a.json.nome} (${a.json.servico})`);\n\nreturn [{\n  json: {\n    total: agendamentos.length,\n    data,\n    texto: `📅 Agenda de ${data}\\n✅ ${agendamentos.length} lembrete(s) enviado(s)\\n\\n${linhas.join('\\n')}`\n  }\n}];"
      },
